{
  "name": "@averay/assert",
  "description": "A collection of runtime TypeScript assertion functions to ensure strict type safety without relying on TypeScript type assertion statements.",
  "homepage": "https://codeberg.org/adamaveray/assert",
  "bugs": {
    "url": "https://codeberg.org/adamaveray/assert/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://codeberg.org/adamaveray/assert.git"
  },
  "author": {
    "name": "Adam Averay",
    "url": "https://adamaveray.au"
  },
  "license": "MIT",
  "version": "0.0.5",
  "type": "module",
  "sideEffects": false,
  "exports": {
    ".": "./index.ts",
    "./*": "./lib/*.ts",
    "./dev": "./dev.ts",
    "./dev/*": "./lib/dev/*.ts"
  },
  "scripts": {
    "format": "bun x codeformat fix",
    "lint": "bun run lint:codeformat && bun run lint:typescript",
    "lint:codeformat": "bun x codeformat check",
    "lint:typescript": "bun --bun x tsc --noEmit",
    "release": "bun --bun x bumpp && bun publish --access public",
    "prepare": "bun --bun x husky"
  },
  "peerDependencies": {
    "typescript": "^5.8 || ^6.0 || ^7.0"
  },
  "devDependencies": {
    "@averay/codeformat": "^0.2.30",
    "@types/bun": "latest",
    "bumpp": "^10.4.1",
    "husky": "^9.1.7"
  }
}
